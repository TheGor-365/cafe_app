<div class="title-card cafe-brandbar">
  <%= link_to root_path, class: 'cafe-brandbar__brand', 'aria-label': "Gor's Coffee — home" do %>
    <span class="cafe-brandbar__mark" aria-hidden="true">GC</span>
    <span class="cafe-brandbar__name">Gor's Coffee</span>
  <% end %>
  <span class="cafe-brandbar__descriptor">Coffee &amp; good moments</span>
  <%# On phones, the homepage starts with its hero; other pages keep a compact header. %>
  <% unless @page == 'home' %>
    <%= render 'layouts/mobile_account_actions' %>
  <% end %>
</div>
