<nav class="col-2 cafe-sidebar" aria-label="Main navigation" tabindex="0">
  <h5 class="link-container">
    <%= link_to 'Home', root_path, class: "link #{@page == 'home' ? 'active' : ''}", 'aria-current': (@page == 'home' ? 'page' : nil) %>
  </h5>
  <h5 class="link-container">
    <%= link_to 'Menu', menu_path, class: "link #{@page == 'menu' ? 'active' : ''}", 'aria-current': (@page == 'menu' ? 'page' : nil) %>
  </h5>
  <h5 class="link-container">
    <%= link_to "Cart (#{current_order.order_items.to_a.sum { |item| item.quantity.to_i }})",
          cart_path, class: "link #{@page == 'cart' ? 'active' : ''}",
          'aria-current': (@page == 'cart' ? 'page' : nil) %>
  </h5>
  <h5 class="link-container">
    <%= link_to 'Catering', catering_path, class: "link #{@page == 'catering' ? 'active' : ''}", 'aria-current': (@page == 'catering' ? 'page' : nil) %>
  </h5>
  <h5 class="link-container">
    <%= link_to 'More Info', info_path, class: "link #{@page == 'info' ? 'active' : ''}", 'aria-current': (@page == 'info' ? 'page' : nil) %>
  </h5>

  <% if user_signed_in? %>
    <h5 class="link-container">
      <%= link_to 'My account', account_path, class: "link #{@page == 'account' ? 'active' : ''}",
            'aria-current': (@page == 'account' ? 'page' : nil) %>
    </h5>
  <% end %>

  <% if current_user&.admin? %>
    <h5 class="link-container">
      <%= link_to 'Manage products', products_path, class: 'link' %>
    </h5>
    <h5 class="link-container">
      <%= link_to 'Manage categories', categories_path, class: 'link' %>
    </h5>
    <h5 class="link-container">
      <%= link_to 'Orders', admin_demo_orders_path, class: 'link' %>
    </h5>
  <% end %>
</nav>
