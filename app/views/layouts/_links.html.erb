<nav class="col-2 cafe-sidebar" aria-label="Main navigation">
  <h5 class="link-container">
    <%= link_to 'Home', root_path, class: "link #{@page == 'home' ? 'active' : ''}" %>
  </h5>
  <h5 class="link-container">
    <%= link_to 'Menu', menu_path, class: "link #{@page == 'menu' ? 'active' : ''}" %>
  </h5>
  <h5 class="link-container">
    <%= link_to "Cart (#{current_order.order_items.to_a.sum { |item| item.quantity.to_i }})",
          cart_path, class: "link #{@page == 'cart' ? 'active' : ''}" %>
  </h5>
  <h5 class="link-container">
    <%= link_to 'Catering', catering_path, class: "link #{@page == 'catering' ? 'active' : ''}" %>
  </h5>
  <h5 class="link-container">
    <%= link_to 'More Info', info_path, class: "link #{@page == 'info' ? 'active' : ''}" %>
  </h5>

  <% if current_user&.admin? %>
    <h5 class="link-container">
      <%= link_to 'Manage products', products_path, class: 'link' %>
    </h5>
    <h5 class="link-container">
      <%= link_to 'Manage categories', categories_path, class: 'link' %>
    </h5>
  <% end %>
</nav>
