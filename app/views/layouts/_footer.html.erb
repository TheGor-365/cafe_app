<footer class="cafe-site-footer" role="contentinfo">
  <div class="cafe-site-footer__top">
    <div class="cafe-site-footer__brand">
      <%= link_to "Gor's Coffee", root_path, class: 'cafe-site-footer__name' %>
      <p>Good coffee, thoughtful web experiences.</p>
      <p class="cafe-site-footer__disclaimer">Portfolio project · No real purchases or payments.</p>
    </div>
    <nav aria-label="Footer navigation" class="cafe-site-footer__nav">
      <div>
        <h2>Explore</h2>
        <%= link_to 'Home', root_path %>
        <%= link_to 'Full menu', menu_path %>
        <%= link_to 'Cart', cart_path %>
        <%= link_to 'Catering concept', catering_path %>
      </div>
      <div>
        <h2>Information</h2>
        <%= link_to 'About us', info_path %>
        <%= link_to 'FAQ', info_path(anchor: 'faq') %>
        <%= link_to 'Location & map', info_path(anchor: 'location') %>
        <%= link_to 'Contact & feedback', info_path(anchor: 'contact') %>
      </div>
    </nav>
  </div>
  <div class="cafe-site-footer__bottom">
    <small>© <%= Time.current.year %> Gor's Coffee · Portfolio project</small>
    <a href="https://github.com/TheGor-365/cafe_app" target="_blank" rel="noopener noreferrer">Source project</a>
  </div>
</footer>
