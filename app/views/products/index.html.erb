<% content_for :title, "Manage Products · Gor's Coffee" %>
<main class="cafe-admin" aria-labelledby="cafe-admin-title">
  <header class="cafe-admin__hero">
    <div>
      <p class="cafe-admin__eyebrow">Restricted · Catalogue administration</p>
      <h1 id="cafe-admin-title">Manage products</h1>
      <p>Edit the sample catalogue. Public customers see the separate menu, not this administrative view.</p>
    </div>
    <%= link_to 'New product', new_product_path, class: 'cafe-admin__button' %>
  </header>
  <nav class="cafe-admin__tabs" aria-label="Catalogue management">
    <%= link_to 'Products', products_path, 'aria-current': 'page' %>
    <%= link_to 'Categories', categories_path %>
    <%= link_to 'Public demo menu', menu_path %>
  </nav>
  <%= tag.p(alert, class: 'cafe-admin__alert', role: 'alert') if alert.present? %>
  <%= tag.p(notice, class: 'cafe-admin__notice', role: 'status') if notice.present? %>
  <section class="cafe-admin__panel" aria-label="Product management table">
    <div class="cafe-admin__table-wrap">
      <table class="cafe-admin__table">
        <thead>
          <tr><th scope="col">Product</th><th scope="col">Category</th><th scope="col">Base price</th><th scope="col">Availability</th><th scope="col">Actions</th></tr>
        </thead>
        <tbody>
          <% @products.each do |product| %>
            <tr>
              <th scope="row">
                <strong><%= product.name %></strong>
                <% if product.featured? %><span class="cafe-admin__tag">Featured</span><% end %>
                <small><%= truncate(product.description.to_s, length: 90) %></small>
              </th>
              <td><%= product.category&.heading || 'Unassigned' %></td>
              <td><%= number_to_currency(product.price) %></td>
              <td><span class="cafe-admin__status"><%= product.available? ? 'Available' : 'Unavailable' %></span></td>
              <td class="cafe-admin__actions">
                <%= link_to 'View', product_path(product) %>
                <%= link_to 'Edit', edit_product_path(product) %>
                <%= link_to 'Sizes', product_product_variants_path(product) %>
                <%= link_to 'Extras', product_product_modifier_options_path(product) %>
                <%= link_to 'Delete', product_path(product), method: :delete,
                      data: { confirm: 'Delete this demo product? Referenced products cannot be deleted.' },
                      class: 'cafe-admin__danger-link' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
    <% if @products.empty? %>
      <p class="cafe-admin__empty">No catalogue products yet. Add the first sample product to begin.</p>
    <% end %>
  </section>
</main>
