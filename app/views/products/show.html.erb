<% content_for :title do %><%= @product.name %> · Gor's Coffee<% end %>
<main class="coffee-product-detail" aria-labelledby="coffee-detail-title">
  <nav class="coffee-product-detail__breadcrumbs" aria-label="Breadcrumb">
    <%= link_to 'Menu', menu_path %>
    <span aria-hidden="true">/</span>
    <%= link_to @product.category.heading, menu_path(category_id: @product.category_id) %>
    <span aria-hidden="true">/</span>
    <span aria-current="page"><%= @product.name %></span>
  </nav>

  <header class="coffee-product-detail__heading">
    <div>
      <p class="coffee-product-detail__eyebrow"><%= @product.category.heading %> · Demo menu</p>
      <h1 id="coffee-detail-title"><%= @product.name %></h1>
      <p><%= @product.description.presence || 'A sample item from our demo menu.' %></p>
      <div class="coffee-product-detail__badges" aria-label="Demo catalogue attributes">
        <% if @product.vegan? %><span>Vegan</span><% end %>
        <% if @product.dairy_free? %><span>Dairy free</span><% end %>
        <% if @product.gluten_free? %><span>Gluten free</span><% end %>
      </div>
    </div>
    <%= link_to 'Back to menu', menu_path(category_id: @product.category_id), class: 'coffee-product-detail__back' %>
  </header>

  <% if @product.available? %>
    <section class="coffee-product-detail__purchase" aria-label="Configure and add <%= @product.name %> to demo cart">
      <div class="coffee-product-detail__intro">
        <h2>Make it yours</h2>
        <p>Choose available options, review the price and add this sample item to your demo basket.</p>
      </div>
      <%# Reuse the exact server-backed menu form, including its no-JavaScript fallback. %>
      <div class="coffee-product-detail__catalog-form">
        <%= render 'menu/products' %>
      </div>
    </section>
  <% else %>
    <section class="coffee-product-detail__unavailable" role="status">
      <h2>Temporarily unavailable</h2>
      <p>This sample product cannot be added to the demo basket right now.</p>
      <%= link_to 'See available items', menu_path, class: 'coffee-product-detail__back' %>
    </section>
  <% end %>

  <aside class="coffee-product-detail__disclaimer">
    <strong>Demo only.</strong> Sample pricing and catalogue information; no real order or payment is placed. Product dietary flags are demonstration attributes, not food-safety guarantees.
  </aside>
</main>
