<%= form_with(model: product, local: true, html: { class: 'cafe-admin__form' }) do |form| %>
  <% if product.errors.any? %>
    <div class="cafe-admin__alert" role="alert">
      <h2><%= pluralize(product.errors.count, 'error') %> prevented this product from being saved</h2>
      <ul><% product.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul>
    </div>
  <% end %>
  <div class="cafe-admin__field">
    <%= form.label :name %>
    <%= form.text_field :name, required: true, class: 'form-control' %>
  </div>
  <div class="cafe-admin__field">
    <%= form.label :description %>
    <%= form.text_area :description, rows: 4, class: 'form-control' %>
  </div>
  <div class="cafe-admin__two-col">
    <div class="cafe-admin__field">
      <%= form.label :price, 'Base price (USD)' %>
      <%= form.number_field :price, min: 0, step: 0.01, required: true, class: 'form-control' %>
    </div>
    <div class="cafe-admin__field">
      <%= form.label :category_id, 'Category' %>
      <%= form.collection_select :category_id, Category.order(:heading), :id, :heading, { prompt: 'Select category' }, { class: 'form-control', required: true } %>
    </div>
  </div>
  <p class="cafe-admin__hint">Image uploads are temporarily disabled because the current Docker code mount is read-only. Existing product images remain unchanged.</p>
  <fieldset class="cafe-admin__checkbox-group">
    <legend>Catalogue availability</legend>
    <% %i[available featured catering].each do |flag| %>
      <label><%= form.check_box flag %> <%= flag.to_s.humanize %></label>
    <% end %>
  </fieldset>
  <fieldset class="cafe-admin__checkbox-group">
    <legend>Dietary attributes</legend>
    <p>These labels are unverified product data; they must not be treated as actual food-safety guarantees.</p>
    <% %i[vegan vegetarian dairy_free gluten_free peanut_free kosher].each do |flag| %>
      <label><%= form.check_box flag %> <%= flag.to_s.humanize %></label>
    <% end %>
  </fieldset>
  <%= form.submit class: 'cafe-admin__button' %>
<% end %>
