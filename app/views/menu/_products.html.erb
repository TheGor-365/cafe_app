<% products_by_category = @products.group_by(&:category_id) %>

<% if @products.empty? %>
  <div class="coffee-menu__empty" role="status">
    <h2>No matching items</h2>
    <p>Try another search or remove a dietary filter.</p>
    <%= link_to 'View the full menu', menu_path, class: 'coffee-menu__reset-link' %>
  </div>
<% else %>
  <p class="coffee-menu__result-count"><%= pluralize(@products.size, 'item') %> available in this demo menu</p>
  <% @cats.each do |category| %>
    <% items = products_by_category.fetch(category.id, []) %>
    <% next if items.empty? %>
    <section class="coffee-menu__section" aria-labelledby="coffee-category-<%= category.id %>">
      <header class="coffee-menu__section-header">
        <h2 id="coffee-category-<%= category.id %>"><%= category.heading %></h2>
        <% if category.body.present? %><p><%= category.body %></p><% end %>
      </header>

      <div class="coffee-menu__grid">
        <% items.each do |product| %>
          <article class="coffee-product-card">
            <div class="coffee-product-card__visual">
              <% if product.image.present? && product.image.url.present? %>
                <%= image_tag product.image.url, alt: product.name, loading: 'lazy', class: 'coffee-product-card__image' %>
              <% else %>
                <span class="coffee-product-card__placeholder" aria-hidden="true">☕</span>
              <% end %>
              <% if product.featured? %><span class="coffee-product-card__featured">Popular pick</span><% end %>
            </div>
            <div class="coffee-product-card__content">
              <h3><%= product.name %></h3>
              <p class="coffee-product-card__description"><%= truncate(product.description.to_s, length: 125) %></p>
              <div class="coffee-product-card__badges" aria-label="Product information">
                <% if product.vegan? %><span>Vegan</span><% end %>
                <% if product.dairy_free? %><span>Dairy free</span><% end %>
                <% if product.gluten_free? %><span>Gluten free</span><% end %>
              </div>
              <div class="coffee-product-card__footer">
                <strong class="coffee-product-card__price"><%= number_to_currency(product.price) %></strong>
                <%= link_to 'Details', product_path(product), class: 'coffee-product-card__details' %>
              </div>
              <%= form_with url: order_items_path, scope: :order_item, method: :post,
                    local: true, class: 'coffee-product-card__cart-form' do |form| %>
                <%= form.hidden_field :product_id, value: product.id, id: nil %>
                <% variants = product.product_variants.select(&:available?) %>
                <% if variants.any? %>
                  <div class="coffee-product-card__config">
                    <%= form.label :product_variant_id, 'Drink size', for: "coffee-size-#{product.id}" %>
                    <%= form.select :product_variant_id,
                        options_for_select(variants.sort_by(&:price_cents).map { |v|
                          ["#{v.label} — #{number_to_currency(BigDecimal(v.price_cents.to_s) / 100)}", v.id]
                        }),
                        {}, id: "coffee-size-#{product.id}", class: 'coffee-product-card__select' %>
                  </div>
                <% end %>
                <% [['milk', 'Milk choice'], ['syrup', 'Syrup'], ['shot', 'Extra espresso']].each do |group_code, label| %>
                  <% options = product.product_modifier_options.select { |o| o.available? && o.group_code == group_code } %>
                  <% next if options.empty? %>
                  <div class="coffee-product-card__config">
                    <% field_id = "coffee-#{group_code}-#{product.id}" %>
                    <%= label_tag field_id, label %>
                    <%= select_tag 'order_item[modifier_option_ids][]',
                          options_for_select([['No extra (+$0.00)', '']] +
                            options.sort_by(&:price_cents).map { |o|
                              ["#{o.label} (+#{number_to_currency(BigDecimal(o.price_cents.to_s) / 100)})", o.id]
                            }), id: field_id, class: 'coffee-product-card__select' %>
                  </div>
                <% end %>
                <%= form.label :quantity, 'Qty', for: "coffee-qty-#{product.id}" %>
                <%= form.number_field :quantity, value: 1, min: 1, max: 20, required: true,
                      id: "coffee-qty-#{product.id}", class: 'coffee-product-card__quantity' %>
                <%= form.submit 'Add to cart', class: 'coffee-product-card__add' %>
              <% end %>
            </div>
          </article>
        <% end %>
      </div>
    </section>
  <% end %>
<% end %>
