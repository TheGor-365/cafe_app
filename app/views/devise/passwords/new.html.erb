<% content_for :title, "Reset Password · Gor's Coffee" %>
<main class="cafe-auth" aria-labelledby="cafe-auth-title">
  <header class="cafe-auth__intro">
    <p class="cafe-auth__eyebrow">Account recovery</p>
    <h1 id="cafe-auth-title">Forgot your password?</h1>
    <p>Request a reset link. Email delivery is not yet verified for this project.</p>
  </header>
  <section class="cafe-auth__card">
    <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>
      <div class="cafe-auth__field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true, class: 'form-control' %>
      </div>
      <%= f.submit 'Request reset instructions', class: 'cafe-auth__submit' %>
    <% end %>
    <nav class="cafe-auth__links" aria-label="Account access links">
      <%= render 'devise/shared/links' %>
    </nav>
  </section>
</main>
