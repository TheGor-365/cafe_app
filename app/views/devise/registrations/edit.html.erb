<% content_for :title, "Edit Profile · Gor's Coffee" %>
<main class="cafe-auth" aria-labelledby="cafe-auth-title">
  <header class="cafe-auth__intro">
    <p class="cafe-auth__eyebrow">My demo account</p>
    <h1 id="cafe-auth-title">Edit your profile</h1>
    <p>Change your account details. Your current password is required to save changes.</p>
  </header>
  <section class="cafe-auth__card">
    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= render 'devise/shared/error_messages', resource: resource %>
      <% if devise_mapping.confirmable? && resource.pending_reconfirmation? %>
        <p class="cafe-auth__notice">Pending email confirmation: <%= resource.unconfirmed_email %></p>
      <% end %>
      <div class="cafe-auth__field">
        <%= f.label :email %>
        <%= f.email_field :email, autofocus: true, autocomplete: 'email', required: true, class: 'form-control' %>
      </div>
      <div class="cafe-auth__field">
        <%= f.label :username %>
        <%= f.text_field :username, autocomplete: 'username', class: 'form-control' %>
      </div>
      <div class="cafe-auth__field">
        <%= f.label :password, 'New password' %>
        <small class="cafe-auth__hint">Leave blank to keep your existing password.</small>
        <%= f.password_field :password, autocomplete: 'new-password', class: 'form-control' %>
      </div>
      <div class="cafe-auth__field">
        <%= f.label :password_confirmation %>
        <%= f.password_field :password_confirmation, autocomplete: 'new-password', class: 'form-control' %>
      </div>
      <div class="cafe-auth__field">
        <%= f.label :current_password %>
        <small class="cafe-auth__hint">Required to confirm changes to your account.</small>
        <%= f.password_field :current_password, autocomplete: 'current-password', required: true, class: 'form-control' %>
      </div>
      <p class="cafe-auth__hint">Avatar uploads remain temporarily disabled until private storage is configured safely. Existing avatars are not deleted.</p>
      <%= f.submit 'Save profile', class: 'cafe-auth__submit' %>
    <% end %>
    <div class="cafe-auth__links">
      <%= link_to 'Back to my account', account_path %>
    </div>
  </section>
  <section class="cafe-auth__danger" aria-labelledby="cafe-auth-danger-title">
    <h2 id="cafe-auth-danger-title">Close your demo account</h2>
    <p>This removes your account record. Your session basket is not a purchase history.</p>
    <%= link_to 'Cancel my account', registration_path(resource_name),
          method: :delete, data: { confirm: 'Permanently delete this demo account?' },
          class: 'cafe-auth__delete' %>
  </section>
</main>
