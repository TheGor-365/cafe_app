<% content_for :title, "Add-ons · Gor's Coffee" %>
<main class="cafe-admin" aria-labelledby="extras-title">
  <header class="cafe-admin__hero">
    <div><p class="cafe-admin__eyebrow">Admin · Drink configuration</p>
      <h1 id="extras-title">Extras: <%= @product.name %></h1>
      <p>Edit milk, syrup and shot options. Previously saved cart line prices are preserved.</p>
    </div>
    <%= link_to 'New add-on', new_product_product_modifier_option_path(@product), class: 'cafe-admin__button' %>
  </header>
  <nav class="cafe-admin__tabs" aria-label="Product configuration">
    <%= link_to 'All products', products_path %>
    <%= link_to 'Sizes', product_product_variants_path(@product) %>
  </nav>
  <section class="cafe-admin__panel">
    <div class="cafe-admin__table-wrap">
      <table class="cafe-admin__table"><thead><tr><th>Group</th><th>Code</th><th>Label</th><th>Extra price</th><th>Available</th><th>Actions</th></tr></thead>
        <tbody><% @options.each do |extra| %><tr>
          <td><%= extra.group_code.humanize %></td>
          <th scope="row"><%= extra.code %></th>
          <td><%= extra.label %></td>
          <td><%= number_to_currency(BigDecimal(extra.price_cents.to_s) / 100) %></td>
          <td><%= extra.available? ? 'Yes' : 'No' %></td>
          <td class="cafe-admin__actions">
            <%= link_to 'Edit', edit_product_product_modifier_option_path(@product, extra) %>
            <% if extra.order_item_modifiers.exists? %>
              <span class="cafe-admin__disabled">In use — disable instead</span>
            <% else %>
              <%= button_to 'Delete', product_product_modifier_option_path(@product, extra),
                    method: :delete, class: 'cafe-admin__danger-link' %>
            <% end %>
          </td>
        </tr><% end %></tbody>
      </table>
    </div>
    <% if @options.empty? %><p>No optional extras configured.</p><% end %>
  </section>
</main>
