<% content_for :title, "My Account · Gor's Coffee" %>
<main class="cafe-account" aria-labelledby="cafe-account-heading">
  <header class="cafe-account__hero">
    <p class="cafe-account__eyebrow">Your space · Demo account</p>
    <h1 id="cafe-account-heading">Welcome<%= ", #{current_user.username}" if current_user.username.present? %>.</h1>
    <p>Manage your demo profile and return to the coffee menu. No real orders or payments are processed.</p>
  </header>

  <section class="cafe-account__grid" aria-label="Account shortcuts">
    <article class="cafe-account__card">
      <h2>Your profile</h2>
      <dl>
        <dt>Username</dt><dd><%= current_user.username.presence || 'Not provided' %></dd>
        <dt>Email</dt><dd><%= current_user.email %></dd>
      </dl>
      <%= link_to 'Edit your details', edit_user_registration_path, class: 'cafe-account__action' %>
      <p class="cafe-account__note">Update your email, username or password. Changing a password requires your current password.</p>
    </article>
    <article class="cafe-account__card">
      <h2>Your demo basket</h2>
      <p class="cafe-account__metric"><%= pluralize(@demo_cart_count, 'sample item') %></p>
      <p>The basket belongs to this browser session; it is not linked to your account or synchronized between devices.</p>
      <%= link_to 'Review demo basket', cart_path, class: 'cafe-account__action' %>
    </article>
    <article class="cafe-account__card">
      <h2>Explore the café</h2>
      <p>Discover categories, customize available drinks and calculate sample prices.</p>
      <%= link_to 'Explore sample menu', menu_path, class: 'cafe-account__action' %>
      <p class="cafe-account__note">This is a portfolio project, not a live café or ordering service.</p>
    </article>
  </section>

  <p class="cafe-account__privacy">Account features are limited to Devise profile settings and the current demo session. There is no order history, payment method, loyalty balance or email verification workflow advertised.</p>
</main>
